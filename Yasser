-- FARM TAB
farmTab:AddLabel("Rock Farming")
 
local function gettool()
    for i, v in pairs(player.Backpack:GetChildren()) do
        if v.Name == "Punch" and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid:EquipTool(v)
        end
    end
    ReplicatedStorage.rEvents.muscleEvent:FireServer("punch", "leftHand")
    ReplicatedStorage.rEvents.muscleEvent:FireServer("punch", "rightHand")
end
 
local function addRockSwitch(name, minDur)
    farmTab:AddSwitch("Farm " .. name, function(bool)
        getgenv().autoFarm = bool
        if bool then
            task.spawn(function()
                while getgenv().autoFarm do
                    task.wait()
                    pcall(function()
                        if player.Durability.Value >= minDur then
                            for i, v in pairs(workspace.machinesFolder:GetDescendants()) do
                                if v.Name == "neededDurability" and v.Value == minDur and 
                                   player.Character:FindFirstChild("LeftHand") and 
                                   player.Character:FindFirstChild("RightHand") then
     
                                    firetouchinterest(v.Parent.Rock, player.Character.RightHand, 0)
                                    firetouchinterest(v.Parent.Rock, player.Character.RightHand, 1)
                                end
                            end
                        end
                    end)
                end
            end)
        end
    end)
end

addRockSwitch("Rock 1k", 1000)
addRockSwitch("Rock 5k", 5000)

-- STATS TAB
statsTab:AddLabel("--- Player Stats Scanner ---")
local selectedStatPlayer = nil
local statInfoLabel = statsTab:AddLabel("Status: No player selected")

for _, p in pairs(Players:GetPlayers()) do
    if p ~= player then
        statsTab:AddButton("Scan: " .. p.Name, function()
            selectedStatPlayer = p
        end)
    end
end

task.spawn(function()
    while true do
        pcall(function()
            if selectedStatPlayer and selectedStatPlayer.Parent then
                local strVal, durVal = "0", "0"
                
                local leaderstats = selectedStatPlayer:FindFirstChild("leaderstats")
                if leaderstats then
                    for _, stat in pairs(leaderstats:GetChildren()) do
                        local sName = string.lower(stat.Name)
                        if sName:find("strength") then
                            strVal = tostring(stat.Value)
                        elseif sName:find("durability") or sName:find("defense") then
                            durVal = tostring(stat.Value)
                        end
                    end
                end
                
                if selectedStatPlayer:FindFirstChild("Durability") then
                    durVal = tostring(selectedStatPlayer.Durability.Value)
                end
                if selectedStatPlayer:FindFirstChild("Strength") then
                    strVal = tostring(selectedStatPlayer.Strength.Value)
                end

                statInfoLabel.Text = "[" .. selectedStatPlayer.Name .. "] | Strength: " .. strVal .. " | Durability: " .. durVal
            end
        end)
        task.wait(1)
    end
end)

-- PERFORMANCE TAB
performanceTab:AddLabel("--- Performance ---")
performanceTab:AddSwitch("Anti Lag", function(bool)
    local lighting = game:GetService("Lighting")
    if bool then
        pcall(function()
            for _, gui in pairs(player.PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") then gui:Destroy() end
            end
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("ParticleEmitter") or obj:IsA("PointLight") or obj:IsA("SpotLight") then
                    obj:Destroy()
                end
            end
            lighting.Brightness = 0
            lighting.ClockTime = 0
            lighting.OutdoorAmbient = Color3.new(0,0,0)
        end)
    end
end)

performanceTab:AddSwitch("Anti AFK", function(bool)
    if bool then
        getgenv().AntiAfkExecuted = true
